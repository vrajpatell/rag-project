APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

RAG_DEFAULT_TOP_K=20
RAG_RERANK_TOP_K=8
RAG_MIN_SOURCE_CONFIDENCE=0.65
RAG_MIN_ANSWERABILITY_SCORE=0.70
RAG_REQUIRE_CITATIONS=true
RAG_ENABLE_ABSTENTION=true

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=128

SPARSE_INDEX_BACKEND=local_bm25
DENSE_INDEX_BACKEND=faiss
VECTOR_DIM=384
FAISS_INDEX_PATH=./data/indexes/faiss.index
BM25_INDEX_PATH=./data/indexes/bm25

METADATA_STORE=sqlite
SQLITE_PATH=./data/metadata.db
POSTGRES_DSN=

OBJECT_STORE=local
LOCAL_OBJECT_STORE_PATH=./data/objects

CACHE_BACKEND=memory
REDIS_URL=

AUTH_MODE=none
API_KEYS=
JWT_PUBLIC_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

OTEL_ENABLED=true
OTEL_SERVICE_NAME=rag-project
PROMETHEUS_ENABLED=true

OPENAI_API_KEY=
